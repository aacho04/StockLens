{
  "name": "stocklens",
  "version": "0.0.1",
  "private": true,
  "description": "Market intelligence + paper trading platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "turbo db:migrate --filter=@stocklens/api",
    "db:seed": "turbo db:seed --filter=@stocklens/api",
    "db:studio": "pnpm --filter=@stocklens/api db:studio",
    "token:upstox": "pnpm --filter @stocklens/api token:upstox",
    "ml:dev": "apps\\ml\\venv\\Scripts\\uvicorn main:app --reload --host 0.0.0.0 --port 8000 --app-dir apps/ml",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,css}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
