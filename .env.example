# StockLens — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Local (Docker Compose): postgresql://stocklens:stocklens@localhost:5432/stocklens
# Production: use a secrets manager (Phase 7)
DATABASE_URL="postgresql://stocklens:stocklens@localhost:5432/stocklens"

# ─── Authentication ───────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=""
# Generate with: openssl rand -base64 64
REFRESH_TOKEN_SECRET=""
# Access token TTL in seconds (default: 900 = 15 min)
JWT_EXPIRES_IN="900"
# Refresh token TTL in seconds (default: 604800 = 7 days)
REFRESH_TOKEN_EXPIRES_IN="604800"

# ─── Server ───────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS="http://localhost:5173"

# ─── Market Data ──────────────────────────────────────────────
# Adapter: "mock" (no key needed) | "finnhub" (Phase 2)
MARKET_DATA_PROVIDER="mock"
# Required when MARKET_DATA_PROVIDER=finnhub
FINNHUB_API_KEY=""

# ─── News (Phase 4) ───────────────────────────────────────────
NEWS_API_KEY=""

# ─── AI Analyst (Phase 5) ─────────────────────────────────────
OPENAI_API_KEY=""

# ─── Redis (Phase 6) ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Email (Phase 4) ──────────────────────────────────────────
# Provider TBD: SES / SendGrid / Postmark
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@stocklens.app"

# ─── Admin Bootstrap ──────────────────────────────────────────
# One-time token for seeding the first Admin account.
# Generate with: openssl rand -hex 32
# After bootstrap completes, this env var is no longer used.
FIRST_ADMIN_BOOTSTRAP_TOKEN=""
