{
  "name": "@stocklens/api",
  "version": "0.0.1",
  "private": true,
  "description": "StockLens backend API — Express + TypeScript + Drizzle",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "token:upstox": "tsx scripts/get-upstox-token.ts",
    "token:auto": "tsx scripts/auto-login-upstox.ts"
  },
  "dependencies": {
    "@stocklens/types": "workspace:*",
    "@stocklens/validators": "workspace:*",
    "argon2": "^0.43.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.14.1",
    "uuid": "^11.1.0",
    "ws": "^8.21.3",
    "yahoo-finance2": "^4.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stocklens/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.1.3"
  }
}
